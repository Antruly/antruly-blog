---
/**
 * 音乐版权页。
 *
 * 播放器现在放的是商业版权作品，走 Meting API 从网易云音乐现取 —— 本站不存储、
 * 也不分发音频文件。这一页负责把这件事说清楚，并给出每首曲子的出处链接。
 *
 * 曲目清单读 src/constants/metingTracks.ts。那份清单和网易云上的歌单是分开的
 * 两处，改了歌单记得同步，否则这页会跟实际播放的内容对不上。
 */
import { Icon } from "astro-icon/components";
import { metingTracks } from "@/constants/metingTracks";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
---

<MainGridLayout
	title="音乐版权"
	description="本站播放器的音乐来源与版权说明"
>
	<div class="card-base px-6 py-6">
		<div class="page-heading">
			<div class="page-icon" aria-hidden="true">
				<Icon name="material-symbols:music-note" />
			</div>
			<div>
				<h2>音乐版权</h2>
			</div>
		</div>

		<div class="mt-4 space-y-3 text-90 text-sm leading-relaxed">
			<p>
				本站播放器的曲目由 <a
					href="https://github.com/metowolf/Meting"
					target="_blank"
					rel="noopener noreferrer"
					class="text-(--primary) hover:underline">Meting</a
				> 接口从 <a
					href="https://music.163.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-(--primary) hover:underline">网易云音乐</a
				> 实时读取，共 {metingTracks.length} 首。音频文件始终由音乐平台的 CDN 提供，
				<strong>本站不存储、不转码、不分发任何音频文件</strong>，也不绕过平台的付费限制。
			</p>
			<p>
				这些曲目都是有版权的商业作品，著作权归各自的词曲作者、演唱者与唱片公司所有。
				下面逐首列出出处，方便定位权利人。
			</p>
		</div>

		<ul class="mt-6 space-y-3">
			{
				metingTracks.map((track) => (
					<li class="rounded-(--radius-large) bg-(--btn-plain-bg) px-4 py-3">
						<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
							<span class="font-medium text-95">{track.name}</span>
							<span class="text-75 text-sm">{track.artist}</span>
						</div>
						<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-60 text-xs">
							<a
								href={`https://music.163.com/song?id=${track.neteaseId}`}
								target="_blank"
								rel="noopener noreferrer"
								class="hover:text-(--primary) hover:underline"
							>
								网易云音乐
							</a>
						</div>
					</li>
				))
			}
		</ul>

		<p class="mt-6 text-60 text-xs leading-relaxed">
			如果你是上述作品的权利人，认为本站的引用方式不妥，欢迎
			<a href="/about/" class="text-(--primary) hover:underline">联系我</a
			>，我会立即把对应曲目从歌单里撤下。
		</p>
	</div>
</MainGridLayout>
