---
/**
 * 首页「精选文章」轮播。
 *
 * 排序沿用 getSortedPosts()：置顶在前，其余按发布时间倒序。
 * 于是「精选」= 你在 frontmatter 里标了 pinned: true 的文章，
 * 置顶不够填满就自动用最新文章补位 —— 不用单独维护一份精选清单。
 *
 * 这里没有复用 PostCard.astro：那张卡片是给文章列表用的，布局（list/grid/masonry）
 * 由父容器 #post-list-container 上的 data-* 属性和一套列表脚本共同驱动，
 * 塞进轮播里会拿到错误的布局。轮播里用一张更紧凑的专用卡片。
 */
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import Carousel from "@/components/features/Carousel.astro";
import { homeCarouselConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";

const cfg = homeCarouselConfig.posts;

// 两个上限取小：配置里的 maxItems，和专给「精选」留的 featuredPostMax
const limit = Math.min(cfg.maxItems, homeCarouselConfig.featuredPostMax);

const sorted = await getSortedPosts();
const pinned = sorted.filter((p) => p.data.pinned);

// 置顶的优先占位，剩下的名额按时间序（getSortedPosts 已经是倒序）补最新文章
const posts = [...pinned, ...sorted.filter((p) => !p.data.pinned)].slice(
	0,
	limit,
);
---

<Carousel
	title={cfg.title}
	icon={cfg.icon}
	href={cfg.href}
	interval={cfg.interval}
	empty={!cfg.enable || posts.length === 0}
>
	{
		posts.map((post) => {
			const cover = processCoverImageSync(post.data.image, post.id);
			const basePath = getFileDirFromPath(post.filePath || "");
			const tags = (post.data.tags || []).slice(0, 2);
			return (
				<a
					href={getPostUrlBySlug(post.id)}
					class="post-carousel-card card-base group flex h-full flex-col overflow-hidden rounded-(--radius-large)"
				>
					<div class="relative aspect-16/9 w-full shrink-0 overflow-hidden bg-neutral-200 dark:bg-neutral-700">
						{cover ? (
							<CoverImage
								src={cover}
								basePath={basePath}
								alt={post.data.title}
								class="h-full w-full transition-transform duration-300 group-hover:scale-110"
								preview={false}
							/>
						) : (
							<div class="flex h-full w-full items-center justify-center">
								<Icon
									name="material-symbols:article"
									class="text-4xl text-neutral-400"
								/>
							</div>
						)}
						{post.data.pinned && (
							<span class="absolute top-2 left-2 z-30 inline-flex items-center gap-1 rounded-full bg-(--primary)/90 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-md">
								<Icon name="material-symbols:push-pin" class="text-xs" />
								置顶
							</span>
						)}
						{post.data.password && (
							<span class="absolute top-2 right-2 z-30 inline-flex items-center rounded-full bg-black/50 px-2 py-0.5 text-xs text-white backdrop-blur-md">
								<Icon name="material-symbols:lock" class="text-xs" />
							</span>
						)}
					</div>

					<div class="flex min-h-0 flex-1 flex-col p-4">
						<h3 class="line-clamp-2 text-base leading-snug font-bold text-neutral-900 transition-colors group-hover:text-(--primary) dark:text-neutral-100">
							{post.data.title}
						</h3>

						{post.data.description && (
							<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
								{post.data.description}
							</p>
						)}

						<div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 text-xs font-medium text-neutral-500 dark:text-neutral-400">
							<span class="inline-flex items-center gap-1">
								<Icon
									name="material-symbols:calendar-today-outline-rounded"
									class="text-sm"
								/>
								{formatDateToYYYYMMDD(post.data.published)}
							</span>
							{post.data.category && (
								<span class="inline-flex items-center gap-1">
									<Icon
										name="material-symbols:folder-rounded"
										class="text-sm"
									/>
									{post.data.category}
								</span>
							)}
						</div>

						{tags.length > 0 && (
							<div class="mt-2 flex flex-wrap items-center gap-1.5">
								{tags.map((tag) => (
									<span class="rounded-md bg-(--btn-regular-bg) px-2 py-0.5 text-xs text-neutral-600 dark:text-neutral-300">
										{tag}
									</span>
								))}
							</div>
						)}
					</div>
				</a>
			);
		})
	}
</Carousel>
