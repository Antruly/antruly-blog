{
	// 部署到 Cloudflare Workers 静态资源（不是 Pages）。
	// 一期形态：只有 assets，没有 main —— 纯静态，零冷启动，分发的就是 dist/ 里的文件。
	// 二期接后端时再加 "main": "worker/index.ts" 和 assets.run_worker_first（只放行 /api/v1/*，不要用 true）。
	"name": "antruly-blog",

	// 兼容性日期：写一个已经稳定放行过的日期，避免用到还没验证的新行为。
	// nodejs_compat 要求 >= 2024-09-23。
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"directory": "./dist",
		// 命中不到文件时返回 dist/404.html（Astro 由 src/pages/404.astro 生成）。
		// 不要用 "single-page-application"：那会让任意错链都返回 200 + 首页，SEO 上很难看。
		"not_found_handling": "404-page"
	},

	// 显示打开 workers.dev 备用地址（antruly-blog.zhu-weiye.workers.dev）。
	// 配了 routes 之后 wrangler 默认会把 workers.dev 关掉，导致自定义域名一旦绑不上
	// 就完全没入口；开着它可以在不碰 DNS 的情况下验证部署是否正常。
	// 注意：workers.dev 在大陆被 DNS 污染（解析到 198.18.0.56），只当备用，正式入口是 ssvr.top。
	"workers_dev": true,

	// 自定义域名。用 custom_domain 而不是裸 route，Cloudflare 会自动建好
	// 对应的 DNS 记录和证书；ssvr.top 的 NS 已经在 Cloudflare，所以不用等 NS 生效。
	// 前提是该主机名上不能已有 A/AAAA/CNAME 记录，否则报 100117。
	"routes": [
		{ "pattern": "ssvr.top", "custom_domain": true },
		{ "pattern": "www.ssvr.top", "custom_domain": true }
	]
}
